@@ -0,0 +1,26 @@
+-- Volta de 20261110000400_zapintel_cache_painel. ANTES, voltar o app (o novo chama
+-- zapintel_analises_pendentes_expirar depois de um lote; o de antes não). Depois, numa transação:
+-- os nomes de sempre voltam a ser as funções de cálculo, com as permissões de antes.
+begin;
+
+drop function if exists public.zapintel_dashboard(bigint, bigint, text);
+alter function public.zapintel_dashboard_calc(bigint, bigint, text) rename to zapintel_dashboard;
+grant execute on function public.zapintel_dashboard(bigint, bigint, text) to authenticated, service_role;
+
+drop function if exists public.zapintel_resumo(bigint);
+alter function public.zapintel_resumo_calc(bigint) rename to zapintel_resumo;
+grant execute on function public.zapintel_resumo(bigint) to authenticated, service_role;
+
+drop function if exists public.zapintel_analises_pendentes(bigint, text);
+alter function public.zapintel_analises_pendentes_calc(bigint, text) rename to zapintel_analises_pendentes;
+grant execute on function public.zapintel_analises_pendentes(bigint, text) to service_role;
+
+drop function if exists public.zapintel_analises_pendentes_expirar(bigint);
+drop function if exists public.zapintel_cache_painel(bigint, text, text, interval);
+drop function if exists public.zapintel_cache_lojas(bigint[]);
+
+-- O guardado do painel (as chaves "Como a loja conversa" ficam).
+delete from public.zapintel_conversa_cache where chave like 'painel:%';
+
+commit;
+notify pgrst, 'reload schema';
