diff --git a/tests/e2e/painel-frio-lento.mjs b/tests/e2e/painel-frio-lento.mjs
new file mode 100644
index 00000000..8f83ea41
--- /dev/null
+++ b/tests/e2e/painel-frio-lento.mjs
@@ -0,0 +1,167 @@
+// O CUSTO DA ABERTURA DO PAINEL DO ZAPINTEL, COM A MÁQUINA LENTA (10/11/2026). LOCAL, empresa 1, dono.
+//   node tests/e2e/painel-frio-lento.mjs [http://localhost:3010] [cpus=0.25] [cpus_muito_lento=0.08]
+// Precisa: Supabase local com a migração 20261110000400 e o app local (:3010) buildado com a fila.
+// Estrangula a CPU do contêiner do Postgres (docker update --cpus) para imitar o banco de 10/11 13h54
+// e confere, contando os eventos e as chamadas do navegador:
+//   A. ANTES (a abertura antiga, no banco): dashboard, resumo e pendentes calculados JUNTOS com teto de
+//      8 s — quantos estouram;
+//   B. DEPOIS, a frio (sem guardado nenhum): o painel abre sem NENHUM zapintel.tempo_esgotado; o dashboard
+//      termina antes de o resumo sair, e o resumo antes das pendentes (uma por vez);
+//   C. duas sessões abrindo juntas, a frio: UM cálculo do dashboard (o cache é da empresa, não da aba);
+//   D. máquina MUITO lenta (o cálculo passa dos 8 s) com um guardado vencido: o painel abre com o guardado,
+//      diz "banco lento", nenhum tempo_esgotado, e o corte vira zapintel.calculo_cortado.
+// No fim: CPU do contêiner de volta e o guardado "painel:" apagado. Não grava nada além disso (e os eventos).
+import { E } from './_usuarios.mjs'
+import { chromium } from 'playwright-core'
+import { execFileSync, spawn } from 'node:child_process'
+const BASE = process.argv[2] || 'http://localhost:3010', SENHA = 'teste-local-22'
+const CPUS = Number(process.argv[3] || 0.25), CPUS_MUITO = Number(process.argv[4] || 0.08)
+const PSQL = 'C:/Ferramentas/pgsql-18.4/bin/psql.exe'
+const CONN = `host=127.0.0.1 port=${process.env.DB_PORT || 54322} dbname=postgres user=postgres password=postgres`
+const sql = (q) => execFileSync(PSQL, [CONN, '-X', '-A', '-t', '-q', '-v', 'ON_ERROR_STOP=1', '-c', q], { encoding: 'utf8', env: { ...process.env, PGCLIENTENCODING: 'UTF8' } }).trim().replace(/\r/g, '')
+const falhas = []; const ok = (m) => console.log('ok  ', m); const falha = (m) => { falhas.push(m); console.log('FALHA', m) }
+const confere = (c, m) => (c ? ok(m) : falha(m))
+const DONO = 'a632db2c-c42b-4973-8008-2d5ca2dbf479'
+const docker = (...a) => execFileSync('docker', a, { encoding: 'utf8' }).trim()
+const DB = docker('ps', '--format', '{{.Names}}').split(/\r?\n/).find((n) => /^supabase_db_/.test(n))
+if (!DB) { console.error('Supabase local não está de pé (sem contêiner supabase_db_*).'); process.exit(2) }
+const CPU_ORIGINAL = Number(docker('inspect', '-f', '{{.HostConfig.NanoCpus}}', DB))
+const cpu = (n) => docker('update', '--cpus', String(n), DB)
+const restaurarCpu = () => { try { cpu(CPU_ORIGINAL ? CPU_ORIGINAL / 1e9 : 2) } catch (e) { console.log('não restaurou a CPU:', String(e).slice(0, 200)) } }
+
+// Uma sessão "como o PostgREST": papel authenticated, o JWT do dono, teto de 8 s.
+const comoDono = (q) => `set statement_timeout = '8s'; select set_config('request.jwt.claims', '${JSON.stringify({ sub: DONO, role: 'authenticated' })}', false); ${q}`
+// Tempo de uma consulta numa sessão própria (processo psql à parte), sem travar o node.
+function cronometrar(rotulo, q) {
+  return new Promise((ok) => {
+    const t = Date.now()
+    const p = spawn(PSQL, [CONN, '-X', '-A', '-t', '-q', '-c', comoDono(q)], { env: { ...process.env, PGCLIENTENCODING: 'UTF8' } })
+    let err = ''
+    p.stdout.on('data', () => {}); p.stderr.on('data', (d) => { err += d })
+    p.on('close', (code) => ok({ rotulo, ms: Date.now() - t, estourou: /statement timeout/.test(err), erro: code ? err.trim().split('\n')[0] : null }))
+  })
+}
+const eventos = (tipo, desde) => Number(sql(`select count(*) from eventos where empresa_id = 1 and tipo = '${tipo}' and em >= '${desde}'`))
+const agoraBanco = () => sql(`select now()::text`)
+const limparGuardado = () => sql(`delete from zapintel_conversa_cache where empresa_id = 1 and chave like 'painel:%'`)
+
+const browser = await chromium.launch({ channel: 'msedge', headless: true })
+async function abrirPainel(ctx, rotulo) {
+  const t0 = Date.now(); const rede = []
+  const p = await ctx.newPage()
+  const qual = (u) => (/\/rpc\/zapintel_dashboard(\?|$)/.test(u) ? 'dashboard' : /\/rpc\/zapintel_resumo(\?|$)/.test(u) ? 'resumo' : /\/zapintel\/api\/perfil\/pendentes/.test(u) ? 'pendentes' : null)
+  p.on('request', (r) => { const q = qual(r.url()); if (q) rede.push({ q, r, ini: Date.now() - t0, fim: null, status: null }) })
+  const fim = async (r) => {
+    const c = rede.find((x) => x.r === r); if (!c) return; c.fim = Date.now() - t0
+    try { const resp = await r.response(); c.status = resp?.status() ?? 'falhou'; if (c.q === 'dashboard' && c.status === 200) c.geradoEm = (await resp.json())?.geradoEm ?? null } catch { c.status = c.status ?? 'falhou' }
+  }
+  p.on('requestfinished', fim); p.on('requestfailed', fim)
+  await p.goto(BASE + '/zapintel', { waitUntil: 'domcontentloaded', timeout: 240000 })
+  // Espera as três terminarem (ou 60 s).
+  for (let i = 0; i < 120 && !(['dashboard', 'resumo', 'pendentes'].every((q) => rede.some((x) => x.q === q && x.fim != null))); i++) await p.waitForTimeout(500)
+  const linhas = rede.map(({ q, ini, fim, status }) => `${q} ${(ini / 1000).toFixed(1)}–${fim == null ? '?' : (fim / 1000).toFixed(1)} s (${status})`)
+  console.log(`  [${rotulo}] ${linhas.join(' | ')}`)
+  return { p, rede }
+}
+async function logar(ctx) {
+  const login = await ctx.newPage()
+  await login.goto(BASE + '/login', { timeout: 240000 })
+  await login.fill('input[type="email"]', E.dono); await login.fill('input[type="password"]', SENHA)
+  await Promise.all([login.waitForURL((u) => !u.pathname.startsWith('/login'), { timeout: 240000 }), login.click('button[type="submit"]')])
+  await login.close()
+}
+
+try {
+  confere(sql(`select count(*) from pg_proc where proname in ('zapintel_dashboard_calc', 'zapintel_cache_painel')`) === '2', 'migração 20261110000400 no banco local')
+  sql(`update usuarios set filial_atual_id = null where id = '${DONO}'`)
+
+  // ── calibração ──────────────────────────────────────────────────────────
+  limparGuardado()
+  const livre = await cronometrar('dashboard_calc', `select length(public.zapintel_dashboard_calc(null, null, 'p2')::text)`)
+  cpu(CPUS)
+  const lento = await cronometrar('dashboard_calc', `select length(public.zapintel_dashboard_calc(null, null, 'p2')::text)`)
+  console.log(`calibração: dashboard sozinho ${livre.ms} ms com a CPU livre, ${lento.ms} ms com --cpus ${CPUS}${lento.estourou ? ' (ESTOUROU)' : ''}`)
+
+  // ── A. antes: as três juntas, no banco ─────────────────────────────────
+  {
+    const desde = agoraBanco()
+    const r = await Promise.all([
+      cronometrar('dashboard', `select length(public.zapintel_dashboard_calc(null, null, 'p2')::text)`),
+      cronometrar('resumo', `select length(public.zapintel_resumo_calc(null)::text)`),
+      cronometrar('pendentes', `select count(*) from public.zapintel_analises_pendentes_calc(1, 'p2')`),
+    ])
+    console.log(`A. ANTES (as três juntas, --cpus ${CPUS}): ${r.map((x) => `${x.rotulo} ${x.ms} ms${x.estourou ? ' ESTOUROU' : ''}`).join(' · ')}`)
+    void desde
+  }
+
+  // ── B. depois, a frio, uma sessão ──────────────────────────────────────
+  {
+    limparGuardado()
+    const desde = agoraBanco()
+    const ctx = await browser.newContext({ viewport: { width: 1400, height: 900 }, locale: 'pt-BR' })
+    await logar(ctx)
+    const { p, rede } = await abrirPainel(ctx, `B. DEPOIS a frio, --cpus ${CPUS}`)
+    const pega = (q) => rede.find((x) => x.q === q)
+    const d = pega('dashboard'), r = pega('resumo'), pe = pega('pendentes')
+    confere(d && r && pe, 'abriu as três: dashboard, resumo, pendentes')
+    confere(eventos('zapintel.tempo_esgotado', desde) === 0, `nenhum zapintel.tempo_esgotado (${eventos('zapintel.tempo_esgotado', desde)})`)
+    confere([d, r, pe].every((x) => x?.status === 200), 'as três responderam 200')
+    confere(d && r && d.fim <= r.ini, 'o resumo só saiu depois de o dashboard terminar')
+    confere(r && pe && r.fim <= pe.ini, 'as pendentes só saíram depois de o resumo terminar')
+    const texto = await p.locator('body').innerText()
+    confere(/esperando resposta/i.test(texto), 'o painel mostra os números')
+    // Reabrir dentro do minuto: sai do guardado.
+    const t = Date.now(); const reab = await abrirPainel(ctx, 'B2. reabrir dentro do minuto')
+    const d2 = reab.rede.find((x) => x.q === 'dashboard')
+    confere(d2 && d2.fim - d2.ini < Math.max(1500, lento.ms / 3), `reabrir em menos de 1 min vem do guardado (${d2 ? d2.fim - d2.ini : '?'} ms; o cálculo leva ${lento.ms} ms)`)
+    void t
+    await ctx.close()
+  }
+
+  // ── C. duas sessões juntas, a frio: um cálculo só ──────────────────────
+  {
+    limparGuardado()
+    const desde = agoraBanco()
+    const [c1, c2] = [await browser.newContext({ locale: 'pt-BR' }), await browser.newContext({ locale: 'pt-BR' })]
+    await logar(c1); await logar(c2)
+    const [a1, a2] = await Promise.all([abrirPainel(c1, 'C. sessão 1'), abrirPainel(c2, 'C. sessão 2')])
+    // Um cálculo só: as duas recebem o MESMO geradoEm (o instante do cálculo guardado).
+    const g = [a1, a2].map((a) => a.rede.find((x) => x.q === 'dashboard')?.geradoEm)
+    console.log(`  geradoEm: ${g.join(' / ')}`)
+    confere(g[0] && g[0] === g[1], 'duas sessões abrindo juntas = UM cálculo do dashboard (mesmo geradoEm; antes: um por sessão)')
+    confere(eventos('zapintel.tempo_esgotado', desde) === 0, 'nenhum zapintel.tempo_esgotado com as duas')
+    await c1.close(); await c2.close()
+  }
+
+  // ── D. máquina MUITO lenta, guardado vencido ───────────────────────────
+  {
+    sql(`update zapintel_conversa_cache set gerado_em = now() - interval '10 minutes' where empresa_id = 1 and chave like 'painel:%'`)
+    cpu(CPUS_MUITO)
+    const desde = agoraBanco()
+    const muito = await cronometrar('dashboard_calc', `select length(public.zapintel_dashboard_calc(null, null, 'p2')::text)`)
+    console.log(`D. calibração: dashboard sozinho com --cpus ${CPUS_MUITO}: ${muito.ms} ms${muito.estourou ? ' (estoura os 8 s)' : ''}`)
+    const ctx = await browser.newContext({ viewport: { width: 1400, height: 900 }, locale: 'pt-BR' })
+    await logar(ctx)
+    const desdeAbertura = agoraBanco()
+    const { p, rede } = await abrirPainel(ctx, `D. --cpus ${CPUS_MUITO}, guardado de 10 min`)
+    const texto = await p.locator('body').innerText()
+    confere(eventos('zapintel.tempo_esgotado', desdeAbertura) === 0, `nenhum zapintel.tempo_esgotado na abertura (${eventos('zapintel.tempo_esgotado', desdeAbertura)})`)
+    confere(/esperando resposta/i.test(texto), 'o painel abre com os números guardados')
+    if (muito.estourou) {
+      confere(/banco lento/.test(texto), 'e diz que são de antes ("banco lento")')
+      confere(eventos('zapintel.calculo_cortado', desdeAbertura) >= 1, `o corte ficou contado (zapintel.calculo_cortado = ${eventos('zapintel.calculo_cortado', desdeAbertura)})`)
+    } else {
+      console.log('  (com esta CPU o cálculo coube nos 8 s: o caminho do guardado não foi exercido — rode com cpus_muito_lento menor)')
+    }
+    void rede; void desde
+    await ctx.close()
+  }
+} catch (e) {
+  falha('erro: ' + String(e).slice(0, 400))
+} finally {
+  restaurarCpu()
+  try { limparGuardado() } catch { /* banco fora */ }
+  await browser.close()
+}
+console.log(falhas.length ? `\n${falhas.length} FALHA(S)` : '\ntudo ok')
+process.exit(falhas.length ? 1 : 0)
