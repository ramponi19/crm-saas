+/**
+ * A fila de consultas do ZapIntel na aba (hooks/zapintel/fila.ts, 10/11/2026).
+ *
+ * Smoke de 10/11 13h54: abrir o painel disparava dashboard, resumo e pendentes no
+ * mesmo instante; com o banco lento, as três passaram dos 8 s juntas. A regra:
+ * uma por vez, a tela antes do menu e do robô, seja qual for a ordem de montagem.
+ *
+ *   npm test
+ */
+import { test, describe } from 'node:test'
+import assert from 'node:assert/strict'
+import { PRIORIDADE, criarFila } from '@/hooks/zapintel/fila'
+
+/** Uma consulta de mentira que só termina quando o teste manda. */
+function consulta(nome: string, log: string[]) {
+  let terminar!: (v: string) => void
+  let falhar!: (e: Error) => void
+  const fn = () => {
+    log.push(`começa ${nome}`)
+    return new Promise<string>((ok, erro) => { terminar = ok; falhar = erro }).finally(() => log.push(`termina ${nome}`))
+  }
+  return { fn, terminar: () => terminar(nome), falhar: (m: string) => falhar(new Error(m)) }
+}
+/** Duas voltas do laço: a da fila (que agenda a próxima com setTimeout 0) e mais uma. */
+const volta = async () => { for (let i = 0; i < 3; i++) await new Promise((r) => setTimeout(r, 0)) }
+
+describe('fila do ZapIntel', () => {
+  test('abertura do painel: robô e menu montam ANTES da tela e mesmo assim a tela sai primeiro, uma por vez', async () => {
+    const fila = criarFila()
+    const log: string[] = []
+    const robo = consulta('pendentes', log), menu = consulta('resumo', log), tela = consulta('dashboard', log)
+    // A ordem de montagem é a pior possível: o robô e o menu (layout) pedem primeiro.
+    const pr = fila.naFila(PRIORIDADE.robo, robo.fn)
+    const pm = fila.naFila(PRIORIDADE.menu, menu.fn)
+    const pt = fila.naFila(PRIORIDADE.tela, tela.fn)
+    assert.deepEqual(log, [], 'nada sai na mesma volta do laço: todos os efeitos da renderização entram antes')
+    await volta()
+    assert.deepEqual(log, ['começa dashboard'])
+    assert.deepEqual(fila.estado(), { esperando: 2, rodando: true })
+    tela.terminar(); assert.equal(await pt, 'dashboard'); await volta()
+    assert.deepEqual(log.slice(-2), ['termina dashboard', 'começa resumo'], 'o menu só depois da tela')
+    menu.terminar(); await pm; await volta()
+    assert.deepEqual(log.slice(-2), ['termina resumo', 'começa pendentes'], 'o robô por último')
+    robo.terminar(); await pr; await volta()
+    assert.deepEqual(fila.estado(), { esperando: 0, rodando: false })
+    // Nunca duas ao mesmo tempo: cada "começa" vem logo depois do "termina" da anterior.
+    const l: string[] = [...log]
+    for (let i = 1; i < l.length - 1; i += 2) assert.ok(l[i].startsWith('termina') && l[i + 1].startsWith('começa'))
+  })
+
+  test('mesma prioridade: ordem de chegada', async () => {
+    const fila = criarFila()
+    const log: string[] = []
+    const a = consulta('a', log), b = consulta('b', log)
+    const pa = fila.naFila(PRIORIDADE.tela, a.fn), pb = fila.naFila(PRIORIDADE.tela, b.fn)
+    await volta(); a.terminar(); await pa; await volta(); b.terminar(); await pb
+    assert.deepEqual(log, ['começa a', 'termina a', 'começa b', 'termina b'])
+  })
+
+  test('uma que falha (57014) devolve o erro a quem pediu e não trava a fila', async () => {
+    const fila = criarFila()
+    const log: string[] = []
+    const a = consulta('dashboard', log), b = consulta('resumo', log)
+    const pa = fila.naFila(PRIORIDADE.tela, a.fn), pb = fila.naFila(PRIORIDADE.menu, b.fn)
+    await volta(); a.falhar('canceling statement due to statement timeout')
+    await assert.rejects(pa, /statement timeout/)
+    await volta(); b.terminar()
+    assert.equal(await pb, 'resumo')
+  })
+
+  test('função que lança na hora (sem promessa) também não trava a fila', async () => {
+    const fila = criarFila()
+    const p = fila.naFila(0, () => { throw new Error('síncrono') })
+    const q = fila.naFila(0, async () => 'depois')
+    await assert.rejects(p, /síncrono/)
+    assert.equal(await q, 'depois')
+  })
+
+  test('a que chega enquanto outra roda espera a vez, mesmo com prioridade maior', async () => {
+    const fila = criarFila()
+    const log: string[] = []
+    const menu = consulta('resumo', log), tela = consulta('dashboard', log)
+    const pm = fila.naFila(PRIORIDADE.menu, menu.fn)
+    await volta()
+    const pt = fila.naFila(PRIORIDADE.tela, tela.fn)
+    await volta()
+    assert.deepEqual(log, ['começa resumo'], 'não interrompe nem corre junto')
+    menu.terminar(); await pm; await volta(); tela.terminar(); await pt
+    assert.deepEqual(log, ['começa resumo', 'termina resumo', 'começa dashboard', 'termina dashboard'])
+  })
+})
