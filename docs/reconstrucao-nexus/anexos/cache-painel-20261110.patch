diff --git a/hooks/zapintel/fila.ts b/hooks/zapintel/fila.ts
new file mode 100644
index 00000000..29e7d878
--- /dev/null
+++ b/hooks/zapintel/fila.ts
@@ -0,0 +1,91 @@
+/**
+ * A FILA DE CONSULTAS DO ZAPINTEL NA ABA (10/11/2026, pedido do Lucas).
+ *
+ * Smoke de 10/11 13h54: só ABRIR o painel disparava três consultas pesadas no mesmo
+ * instante — o dashboard (a página), o resumo (o menu, no layout) e as análises
+ * pendentes (o robô, também no layout). Com o banco lento as três passaram dos 8 s
+ * juntas (9 tempo_esgotado em 16 s); o dashboard sozinho, no mesmo minuto, levou 5,6 s.
+ *
+ * Agora toda consulta do ZapIntel desta aba entra numa fila: UMA por vez, a de menor
+ * `prioridade` primeiro (a tela, depois o menu, depois o robô), e na mesma prioridade
+ * por ordem de chegada. A fila só começa a andar na volta seguinte do laço de eventos:
+ * os efeitos de uma mesma renderização (página, menu e robô montam juntos) entram
+ * todos antes de a primeira sair — assim a ordem não depende de quem montou primeiro.
+ *
+ * Sem React, para o teste medir a mesma regra (tests/zapintel-fila.test.ts).
+ */
+export const PRIORIDADE = {
+  /** A consulta da tela aberta (dashboard, lista de leads, insights…). */
+  tela: 0,
+  /** O menu do ZapIntel (`zapintel_resumo`). */
+  menu: 1,
+  /** O robô das análises pendentes. */
+  robo: 2,
+} as const;
+
+type Item = { prioridade: number; ordem: number; rodar: () => Promise<void> };
+
+export interface Fila {
+  /** Põe `fn` na fila; a promessa resolve (ou rejeita) com o resultado dela. */
+  naFila<T>(prioridade: number, fn: () => Promise<T>): Promise<T>;
+  /** Para o teste: quantas esperam e se há uma rodando. */
+  estado(): { esperando: number; rodando: boolean };
+}
+
+export function criarFila(proximaVolta: (f: () => void) => void = (f) => { setTimeout(f, 0); }): Fila {
+  const itens: Item[] = [];
+  let rodando = false;
+  let agendada = false;
+  let contador = 0;
+
+  const andar = () => {
+    agendada = false;
+    if (rodando || itens.length === 0) return;
+    itens.sort((a, b) => a.prioridade - b.prioridade || a.ordem - b.ordem);
+    const item = itens.shift()!;
+    rodando = true;
+    item.rodar().finally(() => {
+      rodando = false;
+      agendar();
+    });
+  };
+  const agendar = () => {
+    if (agendada || rodando || itens.length === 0) return;
+    agendada = true;
+    proximaVolta(andar);
+  };
+
+  return {
+    naFila<T>(prioridade: number, fn: () => Promise<T>): Promise<T> {
+      return new Promise<T>((resolve, reject) => {
+        itens.push({
+          prioridade,
+          ordem: contador++,
+          rodar: () => {
+            let p: Promise<T>;
+            try { p = fn(); } catch (e) { p = Promise.reject(e); }
+            return p.then(resolve, reject).then(() => undefined);
+          },
+        });
+        agendar();
+      });
+    },
+    estado: () => ({ esperando: itens.length, rodando }),
+  };
+}
+
+/** A fila desta aba (um módulo = uma aba). */
+export const filaZapintel = criarFila();
+
+/** Resolve quando a aba estiver visível (na hora, se já estiver). */
+export function quandoVisivel(): Promise<void> {
+  if (typeof document === "undefined" || !document.hidden) return Promise.resolve();
+  return new Promise((resolve) => {
+    const ver = () => {
+      if (document.hidden) return;
+      document.removeEventListener("visibilitychange", ver);
+      resolve();
+    };
+    document.addEventListener("visibilitychange", ver);
+  });
+}
