diff --git a/supabase/migrations/20261110000400_zapintel_cache_painel.sql b/supabase/migrations/20261110000400_zapintel_cache_painel.sql
new file mode 100644
index 00000000..0a33d469
--- /dev/null
+++ b/supabase/migrations/20261110000400_zapintel_cache_painel.sql
@@ -0,0 +1,209 @@
+-- O CUSTO DA ABERTURA DO PAINEL DO ZAPINTEL: CACHE NO BANCO, PARTILHADO (10/11/2026, pedido do Lucas).
+--
+-- Smoke de 10/11 13h54, loja aberta: só ABRIR o painel deu 9 tempo_esgotado em 16 s — dashboard 9,2–10,3 s,
+-- resumo 8,9–9,7 s, pendentes 9,6–9,7 s, as três juntas, cada aba e cada pessoa recalculando a sua. O teto do
+-- authenticated é 8 s. O dashboard sozinho, no mesmo minuto, levou 5,6 s (em 09/11: 0,8–1,1 s).
+--
+-- Aqui: zapintel_dashboard, zapintel_resumo e zapintel_analises_pendentes passam a servir de um cache por
+-- EMPRESA + LOJAS (o escopo já resolvido) + versão da ficha, calculado no máximo 1 vez por minuto e
+-- partilhado entre todas as pessoas e abas da empresa.
+--
+-- A TABELA: a zapintel_conversa_cache, que já existe (empresa_id, chave text, dados jsonb, gerado_em; chave
+-- primária empresa_id + chave; fechada para anon e authenticated, lida só por função security definer). As
+-- chaves de "Como a loja conversa" são "<dias>:<lojas>"; as daqui começam por "painel:" e não se cruzam.
+-- Nenhuma tabela nova, nenhuma coluna nova.
+--
+-- AS FUNÇÕES: o corpo de cada uma NÃO muda — é renomeada para *_calc (mesmo md5 do corpo, mesmo work_mem,
+-- execução só do dono) e uma função nova com o nome de sempre e a MESMA assinatura faz o cache. O app e os
+-- testes chamam os mesmos nomes com os mesmos parâmetros; só a rota das pendentes ganha o "expirar".
+--
+-- AS REGRAS DO CACHE (zapintel_cache_painel):
+--   1. guardado com menos de 60 s: devolve o guardado (um select por chave primária);
+--   2. senão, UMA sessão por chave calcula (trava consultiva da transação); quem chegar enquanto ela
+--      calcula recebe o guardado anterior, se houver, ou espera o cálculo dela — nunca dois cálculos juntos;
+--   3. o cálculo cortado pelo statement_timeout (57014) com um guardado anterior devolve o guardado com
+--      "atrasado": true (só nos objetos; a lista das pendentes volta como estava) e grava o evento
+--      zapintel.calculo_cortado — a pessoa não vê erro, o painel não some, e o corte continua contado.
+--      Sem guardado nenhum (a primeira vez da chave) o erro sobe como antes.
+--   Atenção: capturar query_canceled também engole um pg_cancel_backend durante o cálculo. É de propósito:
+--   o cálculo pesado já foi interrompido; o que sobra é um select pela chave primária e o return.
+--
+-- Volta: supabase/scripts/volta/volta-zapintel-cache-painel.sql (voltar o app antes, se ele já usar o
+-- zapintel_analises_pendentes_expirar).
+
+-- ------------------------------------------------------------------ o cache genérico
+create or replace function public.zapintel_cache_painel(
+  p_emp     bigint,
+  p_chave   text,
+  p_calculo text,
+  p_ttl     interval default interval '60 seconds'
+)
+returns jsonb
+language plpgsql
+volatile
+security definer
+set search_path = public
+as $$
+declare
+  v_dados jsonb;
+  v_em    timestamptz;
+  v_novo  jsonb;
+  v_trava bigint := hashtextextended('zapintel_cache_painel|' || p_emp::text || '|' || p_chave, 0);
+begin
+  select c.dados, c.gerado_em into v_dados, v_em
+    from zapintel_conversa_cache c where c.empresa_id = p_emp and c.chave = p_chave;
+  if v_em > now() - p_ttl then return v_dados; end if;
+
+  if not pg_try_advisory_xact_lock(v_trava) then
+    -- Outra sessão da empresa está calculando esta chave agora.
+    if v_dados is not null then return v_dados; end if;
+    perform pg_advisory_xact_lock(v_trava);
+    -- Cada comando de uma função volátil vê o que já foi confirmado: o cálculo da outra sessão.
+    select c.dados, c.gerado_em into v_dados, v_em
+      from zapintel_conversa_cache c where c.empresa_id = p_emp and c.chave = p_chave;
+    if v_em > now() - p_ttl then return v_dados; end if;
+  end if;
+
+  begin
+    execute p_calculo into v_novo;
+  exception when query_canceled then
+    if v_dados is null then raise; end if;
+    insert into eventos (empresa_id, tipo, entidade, dados)
+    values (p_emp, 'zapintel.calculo_cortado', 'rpc', jsonb_build_object(
+      'chave', p_chave,
+      'guardado_em', v_em,
+      'duracao_ms', round(extract(epoch from clock_timestamp() - now()) * 1000)));
+    return case when jsonb_typeof(v_dados) = 'object' then v_dados || jsonb_build_object('atrasado', true) else v_dados end;
+  end;
+
+  insert into zapintel_conversa_cache (empresa_id, chave, dados, gerado_em)
+  values (p_emp, p_chave, v_novo, now())
+  on conflict (empresa_id, chave) do update set dados = excluded.dados, gerado_em = excluded.gerado_em;
+  return v_novo;
+end;
+$$;
+
+comment on function public.zapintel_cache_painel(bigint, text, text, interval) is
+  'Cache do painel do ZapIntel em zapintel_conversa_cache (chaves "painel:..."): no máximo 1 cálculo por chave a cada p_ttl, um de cada vez; cálculo cortado pelo tempo devolve o guardado (+ atrasado) e grava zapintel.calculo_cortado. 10/11/2026.';
+
+revoke all on function public.zapintel_cache_painel(bigint, text, text, interval) from public, anon, authenticated, service_role;
+
+-- As lojas do escopo, em ordem, como texto (a chave não depende da ordem do array).
+create or replace function public.zapintel_cache_lojas(p_lojas bigint[])
+returns text
+language sql
+immutable
+set search_path = public
+as $$
+  select array_to_string(array(select distinct x from unnest(p_lojas) x order by x), ',')
+$$;
+
+revoke all on function public.zapintel_cache_lojas(bigint[]) from public, anon, authenticated, service_role;
+
+-- ------------------------------------------------------------------ dashboard
+alter function public.zapintel_dashboard(bigint, bigint, text) rename to zapintel_dashboard_calc;
+revoke all on function public.zapintel_dashboard_calc(bigint, bigint, text) from public, anon, authenticated, service_role;
+
+create function public.zapintel_dashboard(p_filial bigint default null, p_empresa bigint default null, p_versao text default 'p2')
+returns jsonb
+language plpgsql
+volatile
+security definer
+set search_path = public
+as $$
+declare
+  v_emp   bigint;
+  v_lojas bigint[];
+begin
+  -- Mesma checagem de sempre (empresa, ZapIntel ativo, papel, loja ao alcance) ANTES de olhar o cache.
+  select e.empresa, e.filiais into v_emp, v_lojas from zapintel_escopo(p_filial, p_empresa) e;
+  return zapintel_cache_painel(
+    v_emp,
+    'painel:dashboard:' || coalesce(p_versao, '') || ':' || zapintel_cache_lojas(v_lojas),
+    format('select public.zapintel_dashboard_calc(%L::bigint, %L::bigint, %L::text)', p_filial, p_empresa, p_versao));
+end;
+$$;
+
+comment on function public.zapintel_dashboard(bigint, bigint, text) is
+  'O painel do ZapIntel (zapintel_dashboard_calc) pelo cache partilhado de 60 s por empresa + lojas + versão (zapintel_cache_painel). 10/11/2026.';
+
+revoke all on function public.zapintel_dashboard(bigint, bigint, text) from public, anon;
+grant execute on function public.zapintel_dashboard(bigint, bigint, text) to authenticated, service_role;
+
+-- ------------------------------------------------------------------ resumo (o menu)
+alter function public.zapintel_resumo(bigint) rename to zapintel_resumo_calc;
+revoke all on function public.zapintel_resumo_calc(bigint) from public, anon, authenticated, service_role;
+
+create function public.zapintel_resumo(p_empresa bigint default null)
+returns jsonb
+language plpgsql
+volatile
+security definer
+set search_path = public
+as $$
+declare
+  v_emp   bigint;
+  v_lojas bigint[];
+begin
+  select e.empresa, e.filiais into v_emp, v_lojas from zapintel_escopo(null, p_empresa) e;
+  return zapintel_cache_painel(
+    v_emp,
+    'painel:resumo:' || zapintel_cache_lojas(v_lojas),
+    format('select public.zapintel_resumo_calc(%L::bigint)', p_empresa));
+end;
+$$;
+
+comment on function public.zapintel_resumo(bigint) is
+  'O menu do ZapIntel (zapintel_resumo_calc) pelo cache partilhado de 60 s por empresa + lojas (zapintel_cache_painel). 10/11/2026.';
+
+revoke all on function public.zapintel_resumo(bigint) from public, anon;
+grant execute on function public.zapintel_resumo(bigint) to authenticated, service_role;
+
+-- ------------------------------------------------------------------ análises pendentes (robô e Assistente)
+-- Só o service_role chama (a rota e o Assistente passam a empresa da sessão). A lista inteira fica num
+-- jsonb; a paginação do PostgREST (order + range) continua valendo sobre as linhas devolvidas — e cada
+-- página passa a ler o guardado em vez de recalcular a função inteira.
+alter function public.zapintel_analises_pendentes(bigint, text) rename to zapintel_analises_pendentes_calc;
+revoke all on function public.zapintel_analises_pendentes_calc(bigint, text) from public, anon, authenticated, service_role;
+
+create function public.zapintel_analises_pendentes(p_empresa bigint, p_versao text)
+returns table(lead_id bigint, nome text, filial text, tem_ficha boolean, gerado_em timestamp with time zone,
+              mensagens_na_ficha integer, mensagens_agora integer, ultima timestamp with time zone, loja_deve boolean)
+language sql
+volatile
+security definer
+set search_path = public
+as $$
+  select x.lead_id, x.nome, x.filial, x.tem_ficha, x.gerado_em, x.mensagens_na_ficha, x.mensagens_agora, x.ultima, x.loja_deve
+  from jsonb_to_recordset(public.zapintel_cache_painel(
+         p_empresa,
+         'painel:pendentes:' || coalesce(p_versao, ''),
+         format('select coalesce(jsonb_agg(to_jsonb(a)), ''[]''::jsonb) from public.zapintel_analises_pendentes_calc(%L::bigint, %L::text) a',
+                p_empresa, p_versao)))
+       as x(lead_id bigint, nome text, filial text, tem_ficha boolean, gerado_em timestamp with time zone,
+            mensagens_na_ficha integer, mensagens_agora integer, ultima timestamp with time zone, loja_deve boolean)
+$$;
+
+comment on function public.zapintel_analises_pendentes(bigint, text) is
+  'Leads com ficha de IA desatualizada ou sem ficha (zapintel_analises_pendentes_calc), pelo cache partilhado de 60 s por empresa + versão (zapintel_cache_painel). 10/11/2026.';
+
+revoke all on function public.zapintel_analises_pendentes(bigint, text) from public, anon, authenticated;
+grant execute on function public.zapintel_analises_pendentes(bigint, text) to service_role;
+
+-- Depois de um lote de fichas o robô reconta sem esperar o minuto: o guardado vence agora (os dados ficam,
+-- para o caso de o recálculo ser cortado pelo tempo).
+create function public.zapintel_analises_pendentes_expirar(p_empresa bigint)
+returns void
+language sql
+volatile
+security definer
+set search_path = public
+as $$
+  update zapintel_conversa_cache set gerado_em = '-infinity'
+   where empresa_id = p_empresa and chave like 'painel:pendentes:%'
+$$;
+
+revoke all on function public.zapintel_analises_pendentes_expirar(bigint) from public, anon, authenticated;
+grant execute on function public.zapintel_analises_pendentes_expirar(bigint) to service_role;
+
+notify pgrst, 'reload schema';
diff --git a/supabase/scripts/volta/volta-zapintel-cache-painel.sql b/supabase/scripts/volta/volta-zapintel-cache-painel.sql
