# Supabase — projeto principal
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
# CRÍTICO: deve estar disponível no runtime do servidor (não apenas no build).
# No Vercel: Settings → Environment Variables → marcar "Server" (não só "Build").
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────
# WEB PUSH (notificação do chat no celular) — deixar em branco = push desativado (no-op).
# A chave PÚBLICA já vem embutida no código (lib/vapid.ts) e é segura de expor.
# Só é preciso setar a PRIVADA no servidor para o push ser efetivamente enviado.
# Gerar um novo par (se quiser trocar): npx web-push generate-vapid-keys
# No Vercel: Settings → Environment Variables (marcar "Server").
# ─────────────────────────────────────────────────────────────────
VAPID_PRIVATE_KEY=
# Opcional (default = a chave embutida em lib/vapid.ts):
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Opcional (contato exigido pelo protocolo Web Push):
VAPID_SUBJECT=mailto:contato@seudominio.com

# ─────────────────────────────────────────────────────────────────
# E-MAIL transacional (Resend) — deixar em branco = envio desativado (no-op).
# O e-mail de boas-vindas do cadastro só é enviado quando ambas estiverem setadas.
# RESEND_API_KEY: painel do Resend → API Keys.
# EMAIL_FROM: remetente verificado, ex.: "Nexus <ola@seudominio.com>".
# ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ─────────────────────────────────────────────────────────────────
# CANAIS META (WhatsApp Cloud API + Instagram Direct + Messenger)
# Sem estas variáveis o botão "Conectar canal" fica desativado — o app não
# quebra, só não consegue conectar canal novo.
#
# App Meta: JMStoreCRM (952241517333998). O SECRET fica em App Dashboard →
# App settings → Basic → App secret. Ele assina a troca do código pelo token
# do cliente e valida a assinatura dos webhooks: NUNCA vai para o navegador.
# ─────────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
# Versão da Graph API. Atual: v25.0 (v19.0 não conhece os campos de coexistência).
META_GRAPH_VERSION=v25.0

# Configurações do Facebook Login for Business (App Dashboard → FLFB →
# Configurations). São IDs públicos: rodam no navegador, podem ser expostos.
#   WA    → variação "WhatsApp Embedded Signup", produto WhatsApp Cloud API
#   IGMSG → variação "General", ativos Pages + Instagram accounts (serve os DOIS canais)
NEXT_PUBLIC_META_CONFIG_ID_WA=1024208943756843
NEXT_PUBLIC_META_CONFIG_ID_IGMSG=972926629130111

# Token do handshake do webhook. Precisa ser IGUAL ao que está no App Dashboard;
# trocar aqui sem trocar lá derruba o recebimento dos três canais na hora.
# Também é lido pela Edge Function webhook-leads (secret do Supabase).
WEBHOOK_VERIFY_TOKEN=

# ─────────────────────────────────────────────────────────────────
# SEGURANÇA
# ─────────────────────────────────────────────────────────────────

# Chave AES-256-GCM dos TOKENS DE CANAL (lib/canais/crypto.ts).
# Separada da de pagamentos de propósito: token de canal não expira, então
# vazar uma chave não pode entregar o outro cofre.
# Gerar: openssl rand -hex 32
# CRÍTICO: sem esta variável, conectar canal falha alto (nunca grava em texto puro).
CHANNEL_ENCRYPTION_KEY=

# Chave para criptografia AES-256-GCM das credenciais de pagamento dos tenants.
# Gerar: openssl rand -hex 32
# Formato aceito: 64 hex chars (32 bytes) ou base64 de 32 bytes.
# CRÍTICO: sem esta variável, nenhuma credencial de pagamento pode ser salva/lida.
PAYMENT_ENCRYPTION_KEY=

# Segredo compartilhado entre Vercel Cron e a rota /api/cron/[job].
# Gerar: openssl rand -hex 32
# CRÍTICO: sem esta variável, a rota /api/cron/* retorna 401 para qualquer chamada.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────
# PAGAMENTOS — deixar em branco para desativar (modo "em breve")
# Preencher apenas quando escolher a plataforma de cobrança.
#
# Plataformas testadas:
#   Stripe      → stripe.com          (internacional, aceita BRL)
#   Asaas       → asaas.com           (BR, PIX + boleto + cartão)
#   PagSeguro   → pagseguro.uol.com.br
#   Abacatepay  → abacatepay.com      (PIX nativo)
#
# Para ativar: preencha as variáveis abaixo e redeploy.
# Para desativar: deixe em branco — a página /planos mostra "Em breve".
#
# Nota: STRIPE_PRICE_STARTER / STRIPE_PRICE_PRO foram removidas.
# Os price IDs do Stripe agora vêm de planos_config.stripe_price_id (DB).
# ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─────────────────────────────────────────────────────────────────
# SENTRY (relatório de erro) — instalado em 13/08/2026.
# Até então NÃO havia captura de erro nenhuma: falha em produção só era
# descoberta quando alguém reclamava.
# ─────────────────────────────────────────────────────────────────

# NÃO é segredo e já tem valor padrão no código (lib/sentry-comum.ts): o DSN só
# diz onde o relatório cai, e é entregue ao navegador de qualquer forma. Deixar
# em branco NÃO desliga nada — preencha apenas para apontar a outro projeto.
NEXT_PUBLIC_SENTRY_DSN=

# Liga o Sentry em desenvolvimento (=1). Por padrão só reporta em produção: erro
# de digitação local viraria alerta, e ruído treina a equipe a ignorar o painel.
NEXT_PUBLIC_SENTRY_DEV=

# SEGREDO, e só de build. Sem ele o build não sobe os source maps e o erro chega
# como código minificado — reporta, mas não aponta a linha.
# Organization Token do Sentry (sntrys_...), marcado "Sensitive" na Vercel.
# NUNCA com prefixo NEXT_PUBLIC_: isso o entregaria ao navegador.
SENTRY_AUTH_TOKEN=
